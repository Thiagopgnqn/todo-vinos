# Base de datos
DATABASE_URL="file:./dev.db"

# JWT
JWT_ACCESS_SECRET="cambiar-este-secreto-en-produccion-access"
JWT_REFRESH_SECRET="cambiar-este-secreto-en-produccion-refresh"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# WhatsApp — Número del dueño (con código de país, sin +)
