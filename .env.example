ADMIN_PASSWORD="Admin123!"

# Meta (Píxel + API de Conversiones)
META_PIXEL_ID="tu-pixel-id"
META_ACCESS_TOKEN="token-generado-en-administrador-de-eventos"
META_API_VERSION="v23.0"
