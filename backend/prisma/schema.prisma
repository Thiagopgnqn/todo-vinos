generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         String         @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orders       Order[]
  tokens       RefreshToken[]
}

model Product {
  id           String      @id @default(cuid())
  name         String
  description  String
  price        Decimal
  transferPrice Decimal?
  stock        Int
  imageUrl     String?
  type         String      // TINTO | BLANCO | ROSADO | ESPUMANTE
  varietal     String
  year         Int
  winery       String
  region       String
  tastingNotes String?
  pairing      String?
  active       Boolean     @default(true)
  soldCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  customerName    String
  customerPhone   String
  customerEmail   String
  customerAddress String?
  deliveryMethod  String      // PICKUP | DELIVERY
  comments        String?
  status          String      @default("PENDING") // PENDING | CONFIRMED | DELIVERED | CANCELLED
  total           Decimal
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal
  subtotal   Decimal
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
